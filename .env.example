# Server
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/daybook
JWT_SECRET=CHANGE_ME_generate_a_random_secret_at_least_32_characters
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
# Optional: uncomment and set only for the first administrator startup.
# Remove both values immediately after the account is created.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=CHANGE_ME_use_a_unique_password_at_least_16_characters

# Client (Vite exposes VITE_ variables in browser builds)
VITE_API_URL=http://localhost:4000/api
